<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Task Report — <%= user.name %></title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #f5f5f0; color: #1a1a2e; padding: 2rem; }
    .report-wrap { max-width: 800px; margin: 0 auto; background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
    .report-header { background: linear-gradient(135deg, #7c6af7, #a78bfa); padding: 2rem; color: white; }
    .report-title { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800; }
    .report-sub { opacity: 0.85; font-size: 0.9rem; margin-top: 0.3rem; }
    .report-meta { display: flex; gap: 2rem; margin-top: 1.2rem; font-size: 0.85rem; opacity: 0.9; }
    .report-body { padding: 2rem; }
    .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    .stat-box { background: #f9f9f9; border: 1px solid #eee; border-radius: 12px; padding: 1rem; text-align: center; }
    .stat-num { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800; color: #7c6af7; }
    .stat-lbl { font-size: 0.78rem; color: #888; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.2rem; }
    table { width: 100%; border-collapse: collapse; }
    th { background: #f5f5f0; color: #888; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.6rem 0.75rem; text-align: left; }
    td { padding: 0.85rem 0.75rem; border-bottom: 1px solid #f0f0f0; font-size: 0.875rem; }
    tr:last-child td { border-bottom: none; }
    .badge { padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; }
    .badge-high { background: #ffe0e5; color: #ff4d6d; }
    .badge-medium { background: #fff3db; color: #f5a623; }
    .badge-low { background: #e0f7ee; color: #22c97a; }
    .badge-completed { background: #e0f7ee; color: #22c97a; }
    .badge-pending { background: #f0f0f0; color: #888; }
    .section-title { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: #1a1a2e; }
    .footer { text-align: center; padding: 1.5rem; color: #aaa; font-size: 0.8rem; border-top: 1px solid #f0f0f0; }
    @media print { body { background: white; padding: 0; } .report-wrap { box-shadow: none; } }
  </style>
</head>
<body>
  <div class="report-wrap">
    <div class="report-header">
      <div class="report-title">📋 Task Report</div>
      <div class="report-sub">Student Task Manager — Generated Report</div>
      <div class="report-meta">
        <span>👤 <%= user.name %></span>
        <span>✉️ <%= user.email %></span>
        <span>📅 <%= date %></span>
        <span>🎓 <%= user.role %></span>
      </div>
    </div>
    <div class="report-body">
      <div class="stats-row">
        <div class="stat-box"><div class="stat-num"><%= tasks.length %></div><div class="stat-lbl">Total</div></div>
        <div class="stat-box"><div class="stat-num" style="color:#22c97a"><%= completed %></div><div class="stat-lbl">Completed</div></div>
        <div class="stat-box"><div class="stat-num" style="color:#f5a623"><%= pending %></div><div class="stat-lbl">Pending</div></div>
        <div class="stat-box"><div class="stat-num" style="color:#ff4d6d"><%= high %></div><div class="stat-lbl">High Priority</div></div>
      </div>
      <div class="section-title">All Tasks</div>
      <% if (tasks.length === 0) { %>
        <p style="color:#888; text-align:center; padding: 2rem">No tasks found.</p>
      <% } else { %>
      <table>
        <thead>
          <tr><th>Title</th><th>Description</th><th>Priority</th><th>Status</th><th>Due Date</th></tr>
        </thead>
        <tbody>
          <% tasks.forEach(task => { %>
          <tr>
            <td><strong><%= task.title %></strong></td>
            <td style="color:#888"><%= task.description || '—' %></td>
            <td><span class="badge badge-<%= task.priority %>"><%= task.priority %></span></td>
            <td><span class="badge badge-<%= task.status %>"><%= task.status %></span></td>
            <td style="color:#888"><%= task.due_date || '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
    <div class="footer">Generated by Student Task Manager • <%= date %> • EJS Template Engine</div>
  </div>
</body>
</html>